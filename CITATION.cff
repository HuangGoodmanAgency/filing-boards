cff-version: 1.2.0
message: "If you use this dataset, cite it as below. Every row cites its own SEC filing in the source field."
title: "Edgar & Edgarette: every SEC 8-K event the day it is filed, Altman, Piotroski, Beneish and a credibility-weighted forecast range for every filer, scored in public (POPS4 Filing Boards)"
type: dataset
version: "2026.10.26"
date-released: "2026-10-26"
license: CC-BY-4.0
url: "https://www.pops4.com/boards"
repository-code: "https://github.com/HuangGoodmanAgency/filing-boards"
repository: "https://huggingface.co/datasets/jennyota/filing-boards"
doi: "10.5281/zenodo.PENDING"
authors:
  - family-names: "Huang Goodman"
    given-names: "Jenny"
    affiliation: "Hako Shikin LLC, Virginia Beach, Virginia, USA"
